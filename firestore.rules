rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }
    function ds(t) { return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day()); }
    // today, yesterday or tomorrow in UTC (covers every time zone)
    function dayOk(id) {
      return id in [ds(request.time), ds(request.time - duration.value(1, 'd')), ds(request.time + duration.value(1, 'd'))];
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.status == 'active';
      allow update: if (isOwner(uid) && request.resource.data.status == resource.data.status)
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isOwner(uid);
    }

    match /arcs/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);

      match /rules/{rid} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
      match /days/{date} {
        allow read: if isOwner(uid) || isAdmin();
        // a locked (finished/frozen) day can never be edited
        allow create: if isOwner(uid) && dayOk(date);
        allow update: if isOwner(uid) && dayOk(date) && !(resource.data.get('finished', false) == true);
        allow delete: if isOwner(uid);
      }
      match /proofs/{date} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && dayOk(date) && request.resource.data.img.size() < 700000;
        allow delete: if isOwner(uid);
      }
    }

    // sanitized copy used by leaderboard and profiles
    match /publicBoard/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /feed/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      allow delete: if isAdmin() || isOwner(resource.data.uid);
    }

    match /motivations/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // marker docs created manually in the console
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /siteStats/{id} {
      allow read: if true;
      allow write: if signedIn() && request.resource.data.keys().hasOnly(['totalUsers', 'totalHabitsDone']);
    }
  }
}
